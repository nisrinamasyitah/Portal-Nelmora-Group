# Copy this file to ".env" and edit. Everything here is optional.

# Port the portal runs on
PORT=3001

# Set a password to require login (recommended if the portal is ever reachable from the internet).
# Leave empty for local-only use on your own computer.
PORTAL_PASSWORD=

# Optional: also require this email at login (only used when PORTAL_PASSWORD is set).
PORTAL_EMAIL=

# Only needed if you set a password: any long random text. Changing it logs everyone out.
SESSION_SECRET=

# 127.0.0.1 = only this computer can open the portal.
# Use 0.0.0.0 to open it from your phone on the same Wi-Fi (set a PORTAL_PASSWORD first).
HOST=127.0.0.1
